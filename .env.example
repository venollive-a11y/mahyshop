# =============================================================================
# Taha Shop Monorepo — environment orchestration (copy per workspace)
# Ports (shared): Web 3000 | API 5000 | Expo Metro 8081
# =============================================================================

TAHA_APP_ENV=development

# ─── backend/.env — DEVELOPMENT ─────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/taha-shop
MONGODB_ALLOW_LOCAL_FALLBACK=true
MONGODB_FORCE_LOCAL=true
MONGODB_LOCAL_FALLBACK_URI=mongodb://127.0.0.1:27017/taha-shop
MONGODB_USE_MEMORY_FALLBACK=false
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=taha-shop-ma
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@taha-shop-ma.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=
FIREBASE_WEB_API_KEY=
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
OTP_ENCRYPTION_KEY=dev_otp_key_change_in_production
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
API_PUBLIC_URL=http://localhost:5000
STORE_URL=http://localhost:3000
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.100.92:3000,http://localhost:8081,http://192.168.100.92:8081,exp://192.168.100.92:8081
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.100.92:3000
DEPOSIT_AMOUNT_MAD=30
FREE_SHIPPING_THRESHOLD_MAD=200

# ─── backend/.env — PRODUCTION (uncomment and replace secrets) ───────────────
# TAHA_APP_ENV=production
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/taha-shop?retryWrites=true&w=majority&appName=TahaShop
# MONGODB_ALLOW_LOCAL_FALLBACK=false
# MONGODB_FORCE_LOCAL=false
# MONGODB_USE_MEMORY_FALLBACK=false
# API_PUBLIC_URL=https://api.mahyshop.com
# STORE_URL=https://mahyshop.com
# STOREFRONT_URL=https://mahyshop.com
# CLIENT_ORIGINS=https://mahyshop.com,https://www.mahyshop.com,https://admin.mahyshop.com,https://vendors.mahyshop.com,https://influencers.mahyshop.com
# ALLOWED_ORIGINS=https://mahyshop.com,https://www.mahyshop.com,https://admin.mahyshop.com,https://vendors.mahyshop.com,https://influencers.mahyshop.com

# ─── apps/web/.env.local — DEVELOPMENT ──────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_API_PORT=5000
# NEXT_PUBLIC_LAN_HOST=192.168.100.92
# API_PROXY_TARGET=http://127.0.0.1:5000
# NEXT_PUBLIC_STORE_URL=http://localhost:3000
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=taha-shop-ma.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=taha-shop-ma
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=taha-shop-ma.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── apps/web/.env.local — PRODUCTION (Cloudflare Pages build env) ───────────
# TAHA_APP_ENV=production
# NEXT_PUBLIC_API_URL=https://api.mahyshop.com/api
# NEXT_PUBLIC_STORE_URL=https://mahyshop.com
# NEXT_PUBLIC_COOKIE_DOMAIN=.mahyshop.com
# API_PROXY_TARGET=https://api.mahyshop.com
# APPLE_TEAM_ID=
# ANDROID_APP_LINK_SHA256=

# ─── apps/mobile/.env — DEVELOPMENT ─────────────────────────────────────────
# EXPO_PUBLIC_API_URL=http://192.168.100.92:5000/api
# EXPO_PUBLIC_LAN_HOST=192.168.100.92
# EXPO_PUBLIC_API_PORT=5000
# EXPO_PUBLIC_STORE_HOST=mahyshop.com
# EXPO_PUBLIC_WEB_DEV_ORIGIN=http://192.168.100.92:3000
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=taha-shop-ma.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=taha-shop-ma
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=taha-shop-ma.appspot.com
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# ─── apps/mobile/.env — PRODUCTION ──────────────────────────────────────────
# EXPO_PUBLIC_API_URL=https://api.mahyshop.com/api
# EXPO_PUBLIC_STORE_HOST=mahyshop.com
